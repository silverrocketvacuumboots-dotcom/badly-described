{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badly-described",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // The game itself: index.html, days.js, icons. Served free; only /api/* runs the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "badly-described",
      // The Database ID from Cloudflare (Storage & Databases > D1 > badly-described). The Worker creates its own tables.
      "database_id": "fe9a5dca-5ac5-4dbc-9f12-2d5b478222a1"
    }
  ],
  // Caps how fast one connection can guess (a whole day is 7 songs plus wrong guesses).
  // namespace_id must be different from any other Worker on the account (Boreen uses 1001).
  "ratelimits": [
    { "name": "PLAY_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Nightly clean-up of old individual results.
  "triggers": { "crons": ["41 3 * * *"] },
  "observability": { "enabled": true }
}
